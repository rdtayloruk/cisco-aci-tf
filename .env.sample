# ==============================================================================
# Cisco ACI Connection Settings
# ==============================================================================
# Required: The administrator password for the APIC (Cisco ACI controller)
ACI_PASSWORD=

# Optional: APIC admin username (default: admin)
ACI_USERNAME=admin

# Optional: Default APIC URL for all environments (default: Cisco DevNet sandbox URL)
ACI_URL=https://sandboxapicdc.cisco.com

# Optional: Specific override APIC URL for the dev environment (default: same as ACI_URL)
ACI_URL_DEV=https://sandboxapicdc.cisco.com

# ==============================================================================
# Gitea & Runner Configuration
# ==============================================================================
# Optional: Gitea instance base URL (default: http://localhost:3000)
GITEA_URL=http://localhost:3000

# Optional: Gitea Organization name where the repo belongs (default: cisco-aci)
GITEA_ORG=cisco-aci

# Optional: Gitea Admin username (default: cisco-aci-admin)
GITEA_USER=cisco-aci-admin

# Optional: Gitea Admin password (default: Admin123!)
GITEA_PASSWORD=Admin123!

# ==============================================================================
# Terraform Backend Credentials (for Gitea HTTP state backend)
# ==============================================================================
# These credentials will be stored as secrets in Gitea automatically
# to allow the Actions Runner to read/write state files.
TF_HTTP_USERNAME=cisco-aci-admin
TF_HTTP_PASSWORD=Admin123!
